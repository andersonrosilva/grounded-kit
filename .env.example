# Passo 1 · CR-04 / ADR-009: só os NOMES das variáveis. Copie para `.env` e preencha localmente; nunca commite valores.

# Gemini (adaptador providers/gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama (adaptadores providers/ollama; o modelo é configuração obrigatória, sem padrão embutido)
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=

# Postgres com extensão pgvector (adaptador retrieval/pgvector; testes de integração opt-in)
PGVECTOR_URL=
